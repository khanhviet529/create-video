  "segments": [
    {
      "index": 1,
      "kind": "giải thích thường",
      "syllables": 22,
      "text": "Một người đã bị xoá khỏi workspace ba tháng trước. Họ vẫn đọc được comment trong tài liệu nội bộ của bạn."
    },
    {
      "index": 20,
      "kind": "thuật ngữ dày",
      "syllables": 26,
      "text": "Lỗi này có tên. Phía web gọi là IDOR. Trong danh sách OWASP dành cho API, nó đứng số một, tên là broken object level authorization."
    },
    {
      "index": 23,
      "kind": "câu ngắn dứt",
      "syllables": 9,
      "text": "Nên cách sửa không nằm ở việc đổi id."
    },
    {
      "index": 31,
      "kind": "câu dài nhiều vế",
      "syllables": 49,
      "text": "Cách kiểm thì đơn giản. Với mỗi route nhận id từ client, viết một test gọi lại route đó bằng tài khoản thứ hai. Tài khoản không có quyền. Khẳng định nó không nhận được hai trăm. Rồi đếm xem bao nhiêu phần trăm route đã có test đó."
    },
    {
      "index": 35,
      "kind": "câu hỏi kết",
      "syllables": 19,
      "text": "Endpoint gần nhất bạn thêm vào. Nó tự kiểm quyền trên object, hay nó tin vào tầng phía trên?"
    }
  ],
